---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import UseCases from '../components/UseCases.astro';
import TelegramDemo from '../components/TelegramDemo.astro';
import Security from '../components/Security.astro';
import FAQ from '../components/FAQ.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout
  title="Agent Claude · The French Bot — Votre bras droit IA sur Telegram"
  description="Déléguez vos mails, agenda et CRM à l'Agent Claude. Installation sur-mesure pour indépendants et petites sociétés. 100% local, sécurisé, opérationnel en 7 jours."
>
  <div class="ambient" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>
  <main>
    <Nav />
    <Hero />
    <UseCases />
    <TelegramDemo />
    <Security />
    <FAQ />
    <CTAFinal />
    <Footer />
  </main>
</Layout>
